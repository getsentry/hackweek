{
  "hosting": {
    "site": "hackweek-34e1d",
    "public": "build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "build.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=0"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "**",
        "destination": "https://hackweek.sentry.new",
        "type": 302
      }
    ]
  },
  "database": {
    "rules": "database.rules.bolt"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
